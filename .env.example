# Copy to .env and fill in. Never commit .env.

# --- Microsoft Foundry (OpenAI-compatible v1 endpoint, used verbatim as base_url) ---
# e.g. https://<resource>.services.ai.azure.com/openai/v1  or  https://<resource>.openai.azure.com/openai/v1
FOUNDRY_ENDPOINT=
# API key. Leave empty to use Entra ID (DefaultAzureCredential / `az login`).
FOUNDRY_API_KEY=
# Deployment names (not model names) as shown in the Foundry portal
FOUNDRY_CHAT_DEPLOYMENT=
# Smaller/cheaper model for analyze_turn, grading, translation, extraction. Falls back to CHAT if empty.
FOUNDRY_FAST_DEPLOYMENT=
FOUNDRY_EMBED_DEPLOYMENT=
# Fixed at container-creation time (Cosmos vector policy is immutable). Change => run reset.
EMBED_DIMENSIONS=1536
# NOTE: do NOT set AZURE_AI_PROJECT_ENDPOINT here - langchain-azure-ai gives it precedence over `endpoint`.

# --- Cosmos DB vNext emulator (HTTP mode, well-known emulator key; auth is not enforced) ---
COSMOS_ENDPOINT=http://localhost:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE=autochat
COSMOS_CARS_CONTAINER=cars
COSMOS_CHUNKS_CONTAINER=chunks
COSMOS_CHECKPOINTS_CONTAINER=checkpoints

# --- App ---
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- MLflow (local tracing + evaluation; UI: scripts/dev.ps1 mlflow -> http://localhost:5000) ---
AUTOCHAT_TRACING=true
# default: sqlite:///<repo>/mlflow.db (absolute path computed in autochat.observability)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=autochat
# LLM judge deployment for mlflow.genai scorers (defaults to FOUNDRY_CHAT_DEPLOYMENT)
MLFLOW_JUDGE_DEPLOYMENT=
MLFLOW_DISABLE_TELEMETRY=true
